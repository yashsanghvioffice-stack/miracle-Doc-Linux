# /etc/nginx/sites-available/miracle.cloud
# Miracle Desktop on Cloud - Reverse Proxy + Login Gate (v3.7)
#
# Changes from v3.6:
#   - ADDED:   HTTPS support. login.miracleon.cloud now served on 443 with
#              Let's Encrypt cert (issued 2026-06-08, auto-renewed by
#              certbot.timer). Cert path:
#                /etc/letsencrypt/live/login.miracleon.cloud/
#   - ADDED:   80->443 redirect block for login.miracleon.cloud (HSTS-friendly).
#              Apex (miracleon.cloud / www.miracleon.cloud) also redirects to
#              https://login.miracleon.cloud since the cert is single-domain.
#   - ADDED:   Modern TLS hardening: TLSv1.2+1.3 only, OCSP stapling, HSTS,
#              session cache. ssl_session_tickets off (forward secrecy).
#   - FIXED:   proxy_cookie_domain rewrite target changed
#              miracle.cloud -> miracleon.cloud (cookies were being rewritten
#              to the WRONG domain since the production host is miracleon.cloud).
#
# Flow:
#   GET  /                  -> Login page (index.html)
#   POST /login             -> Flask: SQLite + TSplus auth
#                              html5  -> {redirect:"/workspace"}
#                              remote -> {redirect:"/workspace-remote",
#                                          rdp_url:"/rdp/download/<token>"}
#   GET  /workspace         -> HTML5 handshake page (workspace.html)
#   GET  /workspace-remote  -> Spinner + .rdp download trigger page
#   GET  /rdp/download/*    -> Flask: validate token, return .rdp file
#   /admin/*                -> Flask admin CRUD (IP allowlist + API key)
#   /socket.io/*            -> Cookie-routed TSplus proxy (upload/WebSocket-aware)
#   /*  (everything else)   -> Cookie-routed TSplus transparent proxy

# ---------------------------------------------------------------
# WebSocket upgrade map (http context)
# Resolves to "upgrade" when the Upgrade header is present, "close"
# otherwise. Harmless on the plain upload POST (empty $http_upgrade).
# ---------------------------------------------------------------
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=login_limit:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=admin_limit:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=rdp_limit:10m rate=10r/m;

upstream miracle_api {
    server 127.0.0.1:5001;
    keepalive 8;
}

# ---------------------------------------------------------------
# HTTP -> HTTPS REDIRECT
# All plain-HTTP hits (login.miracleon.cloud + apex + www) are
# bounced to https://login.miracleon.cloud. Cert is single-domain
# so apex/www can't terminate TLS -- redirect before the handshake.
# ---------------------------------------------------------------
server {
    listen 80;
    server_name login.miracleon.cloud miracleon.cloud www.miracleon.cloud;

    # Let certbot's HTTP-01 challenge still resolve during renewal
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
    }

    location / {
        return 301 https://login.miracleon.cloud$request_uri;
    }
}

# ---------------------------------------------------------------
# HTTPS MAIN BLOCK
# All real traffic terminates here. Layout mirrors v3.6 with the
# 9 location blocks preserved verbatim except for the cookie-domain
# fix (miracle.cloud -> miracleon.cloud).
# ---------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name login.miracleon.cloud;
    root /var/www/miracle;

    # ---------------------------------------------------------------
    # TLS
    # ---------------------------------------------------------------
    ssl_certificate     /etc/letsencrypt/live/login.miracleon.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/login.miracleon.cloud/privkey.pem;

    ssl_protocols              TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers  off;
    ssl_session_cache          shared:SSL:10m;
    ssl_session_timeout        1d;
    ssl_session_tickets        off;

    ssl_stapling               on;
    ssl_stapling_verify        on;
    ssl_trusted_certificate    /etc/letsencrypt/live/login.miracleon.cloud/chain.pem;
    resolver                   8.8.8.8 1.1.1.1 valid=300s;
    resolver_timeout           5s;

    # HSTS -- 1 year, no subdomains (only login.* is on HTTPS today)
    add_header Strict-Transport-Security "max-age=31536000" always;

    # ---------------------------------------------------------------
    # 1. LOGIN PAGE
    # ---------------------------------------------------------------
    location = / {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma        "no-cache"                            always;
        try_files /index.html =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma        "no-cache"                            always;
        try_files /index.html =404;
    }

    # ---------------------------------------------------------------
    # 2. LOGIN API  (POST only)
    # ---------------------------------------------------------------
    location = /login {
        limit_req zone=login_limit burst=10 nodelay;

        proxy_pass         http://miracle_api/login;
        proxy_http_version 1.1;
        proxy_set_header   Host            localhost;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   Connection      "";
        proxy_read_timeout 15s;
        proxy_send_timeout 5s;

        limit_except POST { deny all; }
    }

    # ---------------------------------------------------------------
    # 3. LOGOUT
    # ---------------------------------------------------------------
    location = /logout {
        proxy_pass         http://miracle_api/logout;
        proxy_http_version 1.1;
        proxy_set_header   Host            localhost;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   Connection      "";
        proxy_read_timeout 5s;
    }

    # ---------------------------------------------------------------
    # 4. HEALTH CHECK
    # ---------------------------------------------------------------
    location = /health {
        proxy_pass       http://miracle_api/health;
        proxy_set_header Host localhost;
        limit_except GET { deny all; }
        access_log off;
    }

    # ---------------------------------------------------------------
    # 5. ADMIN API
    # ---------------------------------------------------------------
    location /admin/ {
        allow 127.0.0.1;
        allow 43.242.225.0/24;
        deny all;

        limit_req zone=admin_limit burst=10 nodelay;

        proxy_pass         http://miracle_api/admin/;
        proxy_http_version 1.1;
        proxy_set_header   Host            localhost;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-API-Key       $http_x_api_key;
        proxy_set_header   Connection      "";

        client_max_body_size 1m;
    }

    # ---------------------------------------------------------------
    # 6a. WORKSPACE (HTML5)
    # ---------------------------------------------------------------
    location = /workspace {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files /workspace.html =404;
    }

    # ---------------------------------------------------------------
    # 6b. WORKSPACE-REMOTE (.rdp download spinner page)
    # ---------------------------------------------------------------
    location = /workspace-remote {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files /workspace-remote.html =404;
    }

    # ---------------------------------------------------------------
    # 6c. RDP DOWNLOAD
    #     One-time token-based .rdp file delivery. Flask validates the
    #     token, marks it used, and returns the per-user .rdp content.
    # ---------------------------------------------------------------
    location ~ "^/rdp/download/[a-f0-9]{32}$" {
        limit_req zone=rdp_limit burst=5 nodelay;

        proxy_pass         http://miracle_api;
        proxy_http_version 1.1;
        proxy_set_header   Host            localhost;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   Connection      "";
        proxy_read_timeout 10s;

        limit_except GET { deny all; }
    }

    # ---------------------------------------------------------------
    # 7. SESSION  -- TSplus session entry after JS login completes
    # ---------------------------------------------------------------
    location = /session {
        resolver 8.8.8.8 valid=30s;
        set $tsplus $cookie_miracle_target;
        if ($tsplus = '') {
            return 302 /;
        }
        proxy_pass            http://$tsplus/;
        proxy_http_version    1.1;
        proxy_set_header      Host              $tsplus;
        proxy_set_header      Referer           http://$tsplus/;
        proxy_set_header      Origin            http://$tsplus;
        proxy_set_header      X-Real-IP         $remote_addr;
        proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header      Cookie            $http_cookie;
        proxy_cookie_domain   ~172\.16\.25\.\d+  miracleon.cloud;
        proxy_cookie_path     /                  /;
        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
        proxy_connect_timeout 10s;
    }

    # ---------------------------------------------------------------
    # 8. SOCKET.IO  -- upload + WebSocket-aware TSplus proxy  (new in v3.6)
    #    Handles the HTML5 socket.io channel: WebSocket session, file
    #    upload POST, file listing, download. Prefix match takes
    #    precedence over the catch-all location / below.
    #
    #    CRITICAL DIFFERENCE vs the catch-all: this block passes the
    #    browser's REAL Referer/Origin through ($http_referer/$http_origin)
    #    and does NOT force them to http://$tsplus/. TSplus's upload "ref2"
    #    check validates the referer against the file-list page; forcing the
    #    root referer triggers CLIENT ERROR 35 and the file is discarded.
    #    Also: no X-Real-IP / X-Forwarded-For, so TSplus IP-stability sees a
    #    single consistent client (the gateway) for session + upload.
    # ---------------------------------------------------------------
    location /socket.io/ {
        resolver 8.8.8.8 valid=30s;
        set $tsplus $cookie_miracle_target;
        if ($tsplus = '') {
            return 302 /;
        }

        proxy_pass            http://$tsplus;
        proxy_http_version    1.1;

        # WebSocket upgrade
        proxy_set_header      Upgrade           $http_upgrade;
        proxy_set_header      Connection        $connection_upgrade;

        proxy_set_header      Host              $tsplus;

        # Pass the REAL browser Referer/Origin -- do NOT force to $tsplus root
        proxy_set_header      Referer           $http_referer;
        proxy_set_header      Origin            $http_origin;

        proxy_set_header      Cookie            $http_cookie;

        # Intentionally NO X-Real-IP / X-Forwarded-For here.

        proxy_cookie_domain   ~172\.16\.25\.\d+  miracleon.cloud;
        proxy_cookie_path     /                  /;

        client_max_body_size  0;

        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
        proxy_connect_timeout 10s;
    }

    # ---------------------------------------------------------------
    # 9. TSPLUS TRANSPARENT PROXY  (catch-all)
    #    Handles workspace.html's action=cp call to /cgi-bin/hb.exe via the
    #    miracle_target cookie. Upgrade/Connection headers repeated here
    #    because defining proxy_set_header in a location drops inherited ones.
    # ---------------------------------------------------------------
    location / {
        resolver 8.8.8.8 valid=30s;

        set $tsplus $cookie_miracle_target;

        if ($tsplus = '') {
            return 302 /;
        }

        proxy_pass            http://$tsplus;
        proxy_http_version    1.1;

        proxy_set_header      Upgrade           $http_upgrade;
        proxy_set_header      Connection        $connection_upgrade;

        proxy_set_header      Host              $tsplus;
        proxy_set_header      Referer           http://$tsplus/;
        proxy_set_header      Origin            http://$tsplus;
        proxy_set_header      X-Real-IP         $remote_addr;
        proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header      Cookie            $http_cookie;
        proxy_cookie_domain   ~172\.16\.25\.\d+  miracleon.cloud;
        proxy_cookie_path     /                  /;
        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
        proxy_connect_timeout 10s;
        proxy_hide_header     X-Powered-By;
        proxy_hide_header     Server;
    }

    access_log /var/log/nginx/miracle.cloud.access.log;
    error_log  /var/log/nginx/miracle.cloud.error.log warn;
}
